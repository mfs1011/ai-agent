# --- Telegram ---
BOT_TOKEN=
# Sizning Telegram ID'ingiz (loyiha egasi — hamma ruxsat). Bilmasangiz: botga /start yozing, ID'ni ko'rsatadi.
OWNER_ID=

# --- LLM: Antigravity CLI (agy) ---
AGY_BIN=agy
# Tez model — chat, moliya, feedlar
AGY_MODEL=gemini-3.8-flash-low
# Kuchli model — loyiha takliflari va kod yozish
AGY_MODEL_SMART=claude-opus-4-6-thinking
AGY_SANDBOX_DIR=./data/agy-sandbox
LLM_TIMEOUT_SEC=120
# Bir vaqtda nechta agy jarayoni (har biri ~220 MB RAM)
AGY_MAX_CONCURRENT=2

# --- Ovoz (STT) — agy CLI orqali ---
# agy uchun model (bo'sh = AGY_MODEL)
STT_AGY_MODEL=
# STT'ga beriladigan qo'shimcha lug'at (vergul bilan)
STT_VOCABULARY=Payme,Click,Uzum,Korzinka,Makro,taksi,Yandex Go

# --- Umumiy ---
DB_PATH=./data/agent.db
# Toshkent = +300 daqiqa
TZ_OFFSET_MINUTES=300
DEFAULT_CURRENCY=UZS

# --- O'zini rivojlantirish (ideas) ---
# Kod yozuvchi agent: agy yoki claude
CODER=agy
CLAUDE_BIN=claude
CLAUDE_MAX_BUDGET_USD=3
# Bot ishlab turgan papka EMAS — loyihaning alohida klon nusxasi (PR shu yerdan ochiladi)
SELF_REPO_PATH=
SELF_BASE_BRANCH=dev
SELF_WORKTREES_DIR=./data/worktrees
IMPLEMENT_TIMEOUT_MIN=40
# Har kuni shu soatda (0-23, mahalliy vaqt) takliflar yuboriladi. Bo'sh = o'chiq.
SUGGEST_HOUR=10
SUGGEST_COUNT=3
